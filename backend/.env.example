# PostgreSQL connection string (Neon example)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secrets — generate random hex strings, e.g. openssl rand -hex 32
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Gmail SMTP — sender address and App Password (NOT your regular password)
GMAIL=you@gmail.com
APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# CORS + invite link origins
FRONTEND_DEV_URL=http://localhost:5173
FRONTEND_URL=https://your-production-url.vercel.app
